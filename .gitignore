# Ignore heavy simulation data files
*.npy
*.fits
*.csv
*.parquet

# Ignore plot outputs
*.png
*.pdf

# Ignore Python cache and compiler files
__pycache__/
*.pyc
.pytest_cache/

# Ignore virtual environments and IDE settings
.venv/
venv/
.idea/
.vscode/
.DS_Store

# Ignore build and package artifacts
build/
*.egg-info/